# Copy this file to .env.development.local and fill in your values.
# .env.development.local is gitignored — safe for personal/machine-specific config.

# Where the Vite dev proxy forwards /api and Keycloak requests.
# Set to http://localhost:8080 to hit your locally running Go backend.
# Defaults to the deployed server if not set.
API_TARGET=http://localhost:8080

# Keycloak — point at your local Keycloak instance or the deployed one.
VITE_KEYCLOAK_URL=http://localhost:8080/keycloak
VITE_KEYCLOAK_REALM=divedata
VITE_KEYCLOAK_CLIENT_ID=divedata-ui-client
